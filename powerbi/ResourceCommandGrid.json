{
  "name": "Resource Command Grid",
  "dataColors": ["#B8FF5A", "#61D7E8", "#F2C94C", "#FF7B72", "#9B8AFB", "#6FCF97"],
  "background": "#09110F",
  "foreground": "#E8EEE9",
